{
  "name": "logimarui-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/run-next-with-port.mjs dev",
    "dev:webpack": "node ./scripts/run-next-with-port.mjs dev --webpack",
    "dev:turbopack": "node ./scripts/run-next-with-port.mjs dev --turbopack",
    "build": "next build",
    "start": "node ./scripts/run-next-with-port.mjs start",
    "lint": "eslint",
    "test:dto-analytics": "node ./scripts/test-dto-analytics.mjs",
    "test:journey": "node ./scripts/test-journey.mjs",
    "test": "npm run test:dto-analytics && npm run test:journey && npm run test:receivables && npm run test:iam && npm run test:iiam-auth && npm run test:extrator",
    "test:extrator": "node ./scripts/test-extrator-period.mjs && node ./scripts/test-extrator-annual.mjs && node ./scripts/test-extrator-destinations-ui.mjs && node ./scripts/test-extrator-auth.mjs",
    "test:iam": "node ./scripts/test-iam.mjs",
    "test:iiam-auth": "node ./scripts/test-iiam-auth.mjs",
    "test:receivables": "node ./scripts/test-receivables.mjs",
    "typecheck": "tsc --noEmit",
    "build-start": "next build && node ./scripts/run-next-with-port.mjs start"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.17.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.9.2",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
